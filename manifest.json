{
    "manifest_version": 2,
    "name": "Letterboxd utils",
    "version": "1.5.0",
    "description": "Utilities for letterboxd.com: fade movies not on your streaming services and show detailed rating stats.",
    "icons": {
        "383": "icon.png"
    },
    "permissions": [
        "https://letterboxd.com/*",
        "https://api.themoviedb.org/3/*",
        "storage"
    ],
    "background": {
        "scripts": [
            "background.js"
        ],
        "persistent": false
    },
    "browser_action": {
        "default_title": "Letterboxd Utils Options",
        "default_icon": {
            "383": "icon.png"
        },
        "default_popup": "options.html"
    },
    "content_scripts": [
        {
            "matches": [
                "https://letterboxd.com/*"
            ],
            "js": [
                "content-script.js"
            ],
            "css": [
                "content.css"
            ]
        }
    ],
    "options_ui": {
        "page": "options.html",
        "browser_style": true,
        "open_in_tab": false
    }
}
